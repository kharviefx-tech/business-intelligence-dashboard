{
  "id": "web-tanstack-start",
  "platform": "web",
  "stack": {
    "id": "tanstack-start",
    "framework": "TanStack Start",
    "rendering": "SSR",
    "buildTool": "Vite",
    "language": "TypeScript",
    "router": "@tanstack/react-router",
    "styling": "Tailwind CSS v4 + shadcn/ui (New York style)",
    "uiLibrary": "shadcn/ui",
    "packageManager": "bun",
    "lockfile": "bun.lock",
    "backend": "Supabase (database, auth, storage) + Supabase Edge Functions",
    "deployTarget": "Cloudflare Workers"
  },
  "versionsFrom": {
    "react": "major",
    "vite": "major",
    "tailwindcss": "major",
    "@tanstack/react-start": "exact",
    "@tanstack/react-router": "exact"
  },
  "pathAlias": { "@/": "src/" },
  "devServer": {
    "script": "dev",
    "command": "bun run dev",
    "buildCommand": "bun run build"
  },
  "routesDir": "src/routes",
  "paths": {
    "homeRoute": "src/routes/index.tsx",
    "rootLayout": "src/routes/__root.tsx",
    "styles": "src/styles.css",
    "componentsDir": "src/components",
    "uiComponentsDir": "src/components/ui",
    "hooksDir": "src/hooks",
    "libDir": "src/lib",
    "mockData": "src/lib/data.ts",
    "types": "src/lib/types.ts",
    "payments": "src/lib/payments.ts",
    "supabaseClient": "src/integrations/supabase/client.ts",
    "edgeFunctionsDir": "supabase/functions",
    "serverRoutesDir": "src/routes/api"
  },
  "scaffold": {
    "placeholderMarker": "data-vibely-blank-page-placeholder",
    "editOnly": ["vite.config.ts", "src/routes/index.tsx"],
    "absent": ["src/pages", "src/server", "src/entry-client.tsx", "src/entry-server.tsx"],
    "unusedScaffolding": [
      "src/integrations/supabase/auth-middleware.ts",
      "src/integrations/supabase/client.server.ts"
    ]
  },
  "criticalFiles": [
    { "path": "src/server.ts", "why": "Cloudflare Workers fetch handler + SSR error wrapper" },
    { "path": "src/start.ts", "why": "TanStack Start instance + error middleware" },
    { "path": "src/router.tsx", "why": "router factory wired to `routeTree`" },
    { "path": "src/routeTree.gen.ts", "why": "auto-generated by TanStack Router; never edit manually" },
    { "path": "src/routes/__root.tsx", "why": "root layout, `<html>` shell, global CSS, fonts, meta" },
    { "path": "src/styles.css", "why": "design tokens (oklch), Tailwind config, global styles" },
    { "path": "src/integrations/supabase/client.ts", "why": "pre-wired browser client; import, never recreate" },
    { "path": "src/integrations/supabase/types.ts", "why": "generated DB types; regenerated by the Supabase tooling, not by hand" },
    { "path": "src/integrations/supabase/auth-attacher.ts", "why": "already wired through `src/start.ts` — leave it alone" },
    { "path": "bun.lock", "why": "changed only by installing from the shell (`bun add`)" }
  ],
  "ui": {
    "kind": "shadcn",
    "dir": "src/components/ui",
    "components": [
      "accordion", "alert-dialog", "alert", "aspect-ratio", "avatar", "badge", "breadcrumb",
      "button", "calendar", "card", "carousel", "chart", "checkbox", "collapsible", "command",
      "context-menu", "dialog", "drawer", "dropdown-menu", "form", "hover-card", "input-otp",
      "input", "label", "menubar", "navigation-menu", "pagination", "popover", "progress",
      "radio-group", "resizable", "scroll-area", "select", "separator", "sheet", "sidebar",
      "skeleton", "slider", "sonner", "switch", "table", "tabs", "textarea", "toggle-group",
      "toggle", "tooltip"
    ]
  },
  "hooks": ["use-mobile"],
  "packages": {
    "internal": ["@cloudflare/vite-plugin", "@tailwindcss/vite", "@tanstack/router-plugin", "vite-tsconfig-paths"],
    "notInstalledExamples": ["three", "@react-three/fiber", "@react-three/drei", "framer-motion"],
    "blocked": [
      { "name": "@tanstack/start", "reason": "does not exist as a package — an instant build break; router exports come from `@tanstack/react-router`" },
      { "name": "@supabase/ssr", "reason": "the session model is bearer/localStorage; cookie storage is not wired" }
    ]
  },
  "env": {
    "publicPrefix": "VITE_",
    "clientAccess": "import.meta.env"
  },
  "hiddenFiles": ["wrangler.jsonc", "routeTree.gen.ts", "tailwind.config.vibely.json"],
  "defaultMeta": {
    "title": "Your App",
    "description": "Replace this with a one-sentence description of your app."
  },
  "keyFiles": [
    "package.json",
    "vite.config.ts",
    "tsconfig.json",
    "src/routes/__root.tsx",
    "src/routes/index.tsx",
    "src/styles.css",
    "src/router.tsx",
    "src/server.ts",
    "src/start.ts"
  ]
}
